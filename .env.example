# Emy V2 — example only. Never commit real secrets.
NODE_ENV=development

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_REST_URL=https://PROJECT_REF.supabase.co/rest/v1
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

CHATWOOT_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=replace_me

EVOLUTION_API_URL=https://evo.example.com
EVOLUTION_INSTANCE=TEST_INSTANCE
EVOLUTION_API_TOKEN=replace_me

SGP_API_URL=https://sgp.example.com
SGP_API_TOKEN=replace_me
SGP_APP=cole_o_appname_do_sgp_aqui
SGP_AUTH_MODE=token_app

LOG_REDACTION=true
AUTO_SEND_TO_CUSTOMER=false
SGP_WRITE_ENABLED=false
EMY_TEST_MODE=true
EMY_TEST_PORT=3333
# Somente números autorizados no WhatsApp de teste, separados por vírgula. Ex: 5581999999999
EMY_TEST_WHATSAPP_ALLOWLIST=
# GitHub — token temporário para push do repositório; revogar após uso
GITHUB_TOKEN=cole_o_token_temporario_aqui
GITHUB_REPOSITORY=Clis-M2/m2online
# SGP Basic Auth opcional; preferir token_app para URA
SGP_USERNAME=
SGP_PASSWORD=

# Internal finance human escalation (optional; keep disabled until approved)
FINANCE_HUMAN_GROUP_JID=
FINANCE_HUMAN_ESCALATION_ENABLED=false
CHATWOOT_NOTES_ENABLED=false

# Financial security hardening
EMY_DOCUMENT_VALIDATION_TTL_MS=1800000
EMY_MAX_DOCUMENT_ATTEMPTS=3

# Humanized WhatsApp delivery pacing
EMY_HUMANIZED_DELIVERY_ENABLED=true
EMY_FIRST_RESPONSE_DELAY_MIN_MS=20000
EMY_FIRST_RESPONSE_DELAY_MAX_MS=30000
EMY_BETWEEN_MESSAGES_DELAY_MS=5000
EMY_TYPING_PRESENCE_ENABLED=true

# Finance follow-up automation
EMY_FINANCE_FOLLOWUP_ENABLED=true
EMY_FINANCE_FOLLOWUP_CHECK_INTERVAL_MS=60000
EMY_WAITING_DOCUMENT_FOLLOWUP_1_MS=600000
EMY_WAITING_DOCUMENT_FOLLOWUP_2_MS=2700000
EMY_WAITING_DOCUMENT_ABANDON_MS=7200000
EMY_PIX_PAYMENT_CHECK_1_MS=900000
EMY_PIX_PAYMENT_CHECK_2_MS=2700000
EMY_BOLETO_PAYMENT_CHECK_1_MS=86400000
EMY_BOLETO_PAYMENT_CHECK_2_MS=259200000
