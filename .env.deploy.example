# Deploy Emy V2 — example only. Never commit real secrets.

# VPS SSH
EMY_VPS_HOST=69.62.104.45
EMY_VPS_PORT=22
EMY_VPS_USER=root
# Prefer SSH key. If using password, keep it only in .env.deploy.local and do not commit.
EMY_VPS_SSH_KEY_PATH=~/.ssh/m2-emy-v2
EMY_VPS_PASSWORD=

# Runtime public URL
EMY_PUBLIC_HOST=emy-v2.m2-online.com.br
EMY_PUBLIC_URL=https://emy-v2.m2-online.com.br
EMY_RUNTIME_PORT=3333

# App path on VPS
EMY_DEPLOY_PATH=/opt/m2online
EMY_PM2_APP_NAME=emy-v2-whatsapp-test
